def build_file_map(folder):
    files = [f for f in glob.glob(os.path.join(folder, '*'))
             if os.path.splitext(f)[1].lower() in IMG_EXTS]
    return {canon(os.path.splitext(os.path.basename(f))[0]): f for f in files}

