def canon(s):
    m = re.search(r'\d+', str(s))
    return str(int(m.group(0))) if m else str(s)

def normalize_gt(df):
    df = df.copy()
    cols = list(df.columns)
    if any('value' in str(c).lower() for c in cols):
        id_col = cols[0]
        val_col = [c for c in cols if 'value' in str(c).lower()][0]
        df['base'] = df[id_col].astype(str).str.replace('_Fovea_X', '', regex=False) \
                                 .str.replace('_Fovea_Y', '', regex=False)
        df['axis'] = df[id_col].astype(str).str[-1]
        df = df.pivot(index='base', columns='axis', values=val_col).reset_index()
        df.columns.name = None
        df.columns = ['image_id', 'X', 'Y']
        cols = list(df.columns)

    def pick(keywords, exclude=None):
        for kw in keywords:
            for c in cols:
                if c == exclude:
                    continue
                cl = str(c).lower()
                if kw in cl and 'index' not in cl and 'unnamed' not in cl:
                    return c
        return None

    id_col = pick(['imageid', 'id', 'image', 'file', 'img', 'name'])
    if id_col is None:
        id_col = cols[0]
    x_col = pick(['fovea_x', 'x_coord', 'coord_x', 'center_x', '_x', 'x'], exclude=id_col)
    y_col = pick(['fovea_y', 'y_coord', 'coord_y', 'center_y', '_y', 'y'], exclude=id_col)
    if x_col is None or y_col is None:
        raise ValueError(f'无法自动识别 X/Y 列，GT 列名为: {cols}')

    out = pd.DataFrame({
        'image_id': df[id_col].astype(str).map(canon),
        'x': pd.to_numeric(df[x_col], errors='coerce').astype(float),
        'y': pd.to_numeric(df[y_col], errors='coerce').astype(float),
    })
    print(f'[GT解析] id列={id_col}, X列={x_col}, Y列={y_col}')
    return out

